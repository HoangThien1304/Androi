# =================================================================
# FILE CẤU HÌNH MẪU (LƯU TẠI: api/.env.example)
# ĐÂY LÀ FILE MẪU AN TOÀN - ĐẨY LÊN GIT REPOSITORY
# =================================================================

# 1. Kết nối Cơ Sở Dữ Liệu SQL Server LocalDB dùng tài khoản sa
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=db_tuonghoangthien_attendance
DB_USER=sa
DB_PASSWORD=thien@134
DB_DRIVER=ODBC Driver 18 for SQL Server

# 2. Khóa Bí Mật Mã Hóa JWT & Thời Gian Token
JWT_SECRET=tuonghoangthien-super-secret-key-2026-attendance-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
OTP_MINUTES=5
OTP_MAX_ATTEMPTS=3
LOCK_MINUTES=5

# 3. Tài Khoản Quản Trị Mặc Định (Seed Admin)
ADMIN_USERNAME=tuonghoangthien
ADMIN_PASSWORD=thien@134
ADMIN_EMAIL=thientuong316@gmail.com

# 4. Cấu Hình SMTP Email (Để trống để dùng chế độ Demo in OTP ra terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=thientuong316@gmail.com
